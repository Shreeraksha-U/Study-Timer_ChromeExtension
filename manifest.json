{
  "manifest_version": 3,
  "name": "FocusTrack",
  "version": "2.0.0",
  "description": "A floating study timer for any webpage, with topic tagging and daily focus analytics. All data stays on your device.",
  "permissions": ["storage", "idle", "activeTab"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "FocusTrack" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["utils.js", "content.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["styles/tailwind.css"], "matches": ["<all_urls>"] }
  ],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
